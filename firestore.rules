rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validBorderColor(color) {
      return color.keys().hasAll(['a', 'b', 'g', 'r'])
        && color.a is number && color.a >= 0 && color.a <= 1
        && color.b is number && color.b >= 0 && color.b <= 1
        && color.g is number && color.g >= 0 && color.g <= 1
        && color.r is number && color.r >= 0 && color.r <= 1;
    }

    function validMap(levelMap, width) {
      return levelMap.cols is list
        && levelMap.cols.size() == width
        && width >= 3
        && width <= 20;
    }

    function validLevel(data) {
      return data.authorId == request.auth.uid
        && data.amount is int
        && data.amount >= 1
        && data.amount <= 8
        && data.myType is int
        && data.myType >= 0
        && data.myType <= 2
        && data.width is int
        && validMap(data.map, data.width)
        && validMap(data.gameMap, data.width)
        && validBorderColor(data.borderColor)
        && data.winOptions is list
        && data.name is string
        && data.index is int
        && data.visibility in ['draft', 'private', 'public'];
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /levels/{id} {
      allow read: if resource.data.visibility == 'public'
        || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if signedIn() && validLevel(request.resource.data);
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && validLevel(request.resource.data);
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
